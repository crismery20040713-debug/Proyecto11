<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="proyecto11.MainPage"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- HEADER -->
        <VerticalStackLayout Grid.Row="0" Padding="20,40,20,10">
            <Label Text="Crismery Auto Import"
                   FontSize="26"
                   TextColor="White"
                   FontAttributes="Bold"/>

            <Label Text="Si no te va bien en el amor, seguro es por que no te has montado..."
                   FontSize="14"
                   TextColor="#94A3B8"/>
        </VerticalStackLayout>

        <!-- BUSCADOR -->
        <Border Grid.Row="1"
                Margin="15,0"
                BackgroundColor="#1E293B"
                StrokeShape="RoundRectangle 20">

            <SearchBar x:Name="vehicleSearchBar"
                       Placeholder="Esto no es Tinder aqui eliges tu..."
                       TextColor="White"
                       PlaceholderColor="#94A3B8"
                       BackgroundColor="Transparent"
                       TextChanged="OnSearchTextChanged"/>
        </Border>

        <!-- LISTA -->
        <CollectionView Grid.Row="2"
                        x:Name="vehiclesCollectionView"
                        Margin="10"
                        ItemsSource="{Binding Vehicles}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Margin="10"
                            BackgroundColor="#1E293B"
                            StrokeShape="RoundRectangle 20">

                        <Grid RowDefinitions="180, Auto">

                            <!-- IMAGEN -->
                            <Grid>
                                <Image Source="{Binding Imagen}"
                                       Aspect="AspectFill"/>

                                <Border BackgroundColor="#22C55E"
                                        Padding="6"
                                        Margin="10"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        StrokeShape="RoundRectangle 10">

                                    <Label Text="{Binding Precio_Venta, StringFormat='${0:N0}'}"
                                           TextColor="White"
                                           FontSize="12"
                                           FontAttributes="Bold"/>
                                </Border>
                            </Grid>

                            <!-- INFO -->
                            <VerticalStackLayout Grid.Row="1" Padding="15">

                                <Label Text="{Binding Marca}"
                                       FontSize="18"
                                       TextColor="White"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding Modelo}"
                                       FontSize="14"
                                       TextColor="#94A3B8"/>

                                <Label Text="{Binding Tipo}"
                                       FontSize="12"
                                       TextColor="#38BDF8"/>

                                <Button Text="Ver detalles"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        CornerRadius="12"
                                        Margin="0,10,0,0"/>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>